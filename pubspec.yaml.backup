name: jamsetgemini
description: "App per ricerca e gestione spartiti musicali"
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # CORE
  provider: ^6.1.1
  path_provider: ^2.1.0
  path: ^1.8.3
  shared_preferences: ^2.2.2

  # DATABASE
  sqflite: ^2.3.0
  sqlite3_flutter_libs: ^0.5.0
  sqflite_common_ffi: ^2.3.0

  # FILE OPERATIONS
  file_picker: ^6.2.1
  open_file: ^3.2.1
  csv: ^5.0.2
  url_launcher: ^6.2.0

  # UTILITIES
  http: ^0.13.6
  intl: ^0.19.0
  permission_handler: ^11.1.0
  speech_to_text: ^7.3.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.2

flutter:
  uses-material-design: true

  assets:
    - assets/images/
    - assets/databases/
    - assets/pdfs/